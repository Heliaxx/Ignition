	float n_in14p2 = 1000.00000;
	float n_out14p0 = clamp(n_out5p0, n_in14p1, n_in14p2);


// FloatOp:13
	float n_in13p1 = 300.00000;
	float n_out13p0 = n_out14p0 / n_in13p1;


// FloatOp:12
	float n_in12p1 = 2.00000;
	float n_out12p0 = pow(n_out13p0, n_in12p1);


// VectorOp:10
	vec3 n_out10p0 = n_out9p0 * vec3(n_out12p0);


// VectorOp:11
	vec3 n_out11p0 = n_out8p0 + n_out10p0;


// Output:0
	VERTEX = n_out11p0;


}

void fragment() {
