// VectorOp:11
	vec3 n_out11p0 = vec3(n_out20p0) * vec3(n_out10p0.xyz);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	METALLIC = n_out5p0;
	ROUGHNESS = n_out4p0;
	EMISSION = n_out11p0;


}
