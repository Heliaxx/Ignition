	float n_out13p0 = pow(n_out12p0, n_in13p1);


// Clamp:14
	float n_in14p1 = 0.00000;
	float n_in14p2 = 1000.00000;
	float n_out14p0 = clamp(n_out13p0, n_in14p1, n_in14p2);


// FloatOp:16
	float n_in16p1 = 2500.00000;
	float n_out16p0 = n_out12p0 / n_in16p1;


// FloatOp:17
	float n_in17p0 = 1.00000;
	float n_out17p0 = n_in17p0 - n_out16p0;


// Clamp:18
	float n_in18p1 = 0.00000;
	float n_in18p2 = 1.00000;
	float n_out18p0 = clamp(n_out17p0, n_in18p1, n_in18p2);


// FloatOp:19
	float n_in19p1 = 1.50000;
	float n_out19p0 = n_out18p0 * n_in19p1;


// FloatOp:15
	float n_out15p0 = n_out14p0 * n_out19p0;


// FloatOp:20
